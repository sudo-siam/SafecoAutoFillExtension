{
  "manifest_version": 3,
  "name": "Safeco AutoFill Extension",
  "version": "1.0",
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "downloads",
    "downloads.open",
    "activeTab",
    "webNavigation",
    "webRequest",
    "webRequestBlocking",
    "https://script.google.com/macros/s/*",
    "<all_urls>"
  ],
  "host_permissions": [
    "https://script.google.com/macros/s/*",
    "https://personal.safeco.com/*",
    "https://now.agent.safeco.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Safeco AutoFill Extension"
  },
  "content_scripts": [
    {
      "matches": [
        "https://personal.safeco.com/*",
        "https://now.agent.safeco.com/*",
        "https://personal.safeco.com/personal/Auto/CurrentCarrierReportViewer.aspx*"
      ],
      "js": ["html2pdf.bundle.min.js", "env.js", "content.js", "utils.js", "report.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
