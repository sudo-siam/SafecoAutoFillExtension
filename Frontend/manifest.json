{
  "manifest_version": 3,
  "name": "Safeco AutoFill Extension",
  "version": "1.0",
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "downloads",
    "activeTab",
    "webNavigation",
    "https://script.google.com/macros/s/*",
    "<all_urls>"
  ],
  "host_permissions": [
    "https://script.google.com/macros/s/*",
    "https://personal.safeco.com/*",
    "https://now.agent.safeco.com/start"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Safeco AutoFill Extension"
  },
  "content_scripts": [
    {
      "matches": [
        "https://now.agent.safeco.com/*",
        "https://personal.safeco.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
